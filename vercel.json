{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/bundle-api.mjs && npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path+",
      "destination": "/api/[...path]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/rag-embed",
      "schedule": "0 4 * * *"
    }
  ]
}
