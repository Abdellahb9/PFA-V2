# =============================================================================
# Environment variables - Assistant IA PHOSBOUCRAA
# Copy this file to `.env` and adjust values before running docker-compose.
# =============================================================================

# --- General ---------------------------------------------------------------
PROJECT_NAME="Assistant IA PHOSBOUCRAA"
ENVIRONMENT=development            # development | staging | production
API_V1_PREFIX=/api/v1

# --- PostgreSQL / Supabase -------------------------------------------------
POSTGRES_USER=phosboucraa
POSTGRES_PASSWORD=phosboucraa
POSTGRES_DB=phosboucraa
# Local Docker Postgres (default). Leave as-is to use the bundled `db` service.
DATABASE_URL=postgresql+psycopg://phosboucraa:phosboucraa@db:5432/phosboucraa
#
# --- To use Supabase instead, uncomment one of the lines below and fill in your
#     project ref / region / password (Supabase > Project Settings > Database).
#     Keep the `postgresql+psycopg://` prefix (psycopg3 driver). URL-encode any
#     special characters in the password (e.g. @ -> %40).
#
# Recommended: Session pooler (IPv4-friendly, supports prepared statements):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Direct connection (IPv6 only unless you bought the IPv4 add-on):
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# Transaction pooler (port 6543): set DB_DISABLE_PREPARED_STATEMENTS=true as well.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_DISABLE_PREPARED_STATEMENTS=false

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO / S3 ------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false

# --- Security / JWT --------------------------------------------------------
# Generate a strong secret: `openssl rand -hex 32`
SECRET_KEY=CHANGE_ME_super_secret_key_for_jwt_signing_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- AI / NLP --------------------------------------------------------------
# LLM provider for structured extraction (OpenAI or Mistral). Optional:
# the pipeline falls back to spaCy-only extraction when no key is provided.
LLM_PROVIDER=mistral               # mistral | openai | none
OPENAI_API_KEY=
MISTRAL_API_KEY=
SPACY_MODEL_FR=fr_core_news_md
SPACY_MODEL_EN=en_core_web_sm
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- Frontend --------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1

# --- Bootstrap admin (created on first migration seed) ----------------------
FIRST_ADMIN_EMAIL=admin@phosboucraa.ma
FIRST_ADMIN_PASSWORD=Admin@1234
