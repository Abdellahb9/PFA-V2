# =============================================================================
# Variables d'environnement — Assistant IA PHOSBOUCRAA (Vercel + Supabase)
# Copiez ce fichier en `.env` pour les scripts locaux (npm run eval:rag…) ;
# en production, déclarez-les dans Vercel (voir DEPLOYMENT.md § 1).
# =============================================================================

# --- Supabase (API) ------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # secret

# --- LLM / embeddings (API) ----------------------------------------------------
GROQ_API_KEY=<groq-api-key>                    # secret
# GROQ_MODEL=openai/gpt-oss-120b               # assistant
# GROQ_EXTRACT_MODEL=openai/gpt-oss-20b        # extraction des CV
GEMINI_API_KEY=                                # secret (Google AI Studio) ; vide = recherche plein-texte seule

# --- E-mail après échange d'offre (API, optionnel) -----------------------------
RESEND_API_KEY=
MAIL_FROM=
OFFICE_NAME=
OFFICE_ADDRESS=
OFFICE_CONTACT=
# DOCS_DEADLINE_DAYS=5

# --- Routes internes (API) -------------------------------------------------------
# Protège /api/analyze-cv et /api/rag-embed ; Vercel Cron l'envoie de lui-même.
CRON_SECRET=                                   # secret ; ex. openssl rand -hex 32

# --- Diagnostic (API, optionnel) -------------------------------------------------
# RAG_DEBUG=1

# --- Frontend (publiques : intégrées au bundle client) -------------------------
VITE_API_URL=/api
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
