# =============================================================================
# Environment variables - Assistant IA PHOSBOUCRAA (SUPABASE CONFIGURATION)
# Configuration pour utiliser Supabase au lieu de PostgreSQL local
# =============================================================================

# --- General ---------------------------------------------------------------
PROJECT_NAME="Assistant IA PHOSBOUCRAA"
ENVIRONMENT=production             # development | staging | production
API_V1_PREFIX=/api/v1

# --- Supabase --------------------------------------------------------------
# ⚠️ IMPORTANT : Remplacez par votre chaîne de connexion Supabase
# Format : postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres
# 
# Exemple :
# DATABASE_URL=postgresql+psycopg://postgres.abcdefghijklmn:MyS3cur3P@ss@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
#
# 🔧 Comment obtenir cette chaîne :
# 1. Allez dans Settings → Database dans votre projet Supabase
# 2. Copiez la "Connection string" (URI)
# 3. Remplacez "postgresql://" par "postgresql+psycopg://"
# 4. Remplacez [YOUR-PASSWORD] par votre vrai mot de passe

DATABASE_URL=postgresql+psycopg://postgres.VOTRE_PROJECT_REF:VOTRE_PASSWORD@VOTRE_HOST.supabase.com:5432/postgres

# Variables PostgreSQL (non utilisées avec Supabase, mais gardées pour compatibilité)
POSTGRES_USER=phosboucraa
POSTGRES_PASSWORD=phosboucraa
POSTGRES_DB=phosboucraa

# --- Redis -----------------------------------------------------------------
# Option 1 : Redis local via Docker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Option 2 : Redis Cloud (Upstash, Redis Cloud, etc.)
# REDIS_URL=redis://default:your_password@your-redis-host:6379
# CELERY_BROKER_URL=redis://default:your_password@your-redis-host:6379
# CELERY_RESULT_BACKEND=redis://default:your_password@your-redis-host:6379

# --- MinIO / S3 ------------------------------------------------------------
# Option 1 : MinIO local via Docker
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false

# Option 2 : AWS S3 ou Supabase Storage
# MINIO_ENDPOINT=s3.amazonaws.com
# MINIO_ROOT_USER=your_aws_access_key
# MINIO_ROOT_PASSWORD=your_aws_secret_key
# MINIO_BUCKET=phosboucraa-documents
# MINIO_SECURE=true

# Option 3 : Supabase Storage (nécessite adaptation du code storage.py)
# SUPABASE_URL=https://abcdefghijklmn.supabase.co
# SUPABASE_KEY=your_supabase_anon_key
# SUPABASE_BUCKET=documents

# --- Security / JWT --------------------------------------------------------
# ⚠️ GÉNÉRATION OBLIGATOIRE : openssl rand -hex 32
# NE PAS UTILISER LA VALEUR PAR DÉFAUT EN PRODUCTION !
SECRET_KEY=CHANGEZ_MOI_utilisez_openssl_rand_hex_32_pour_generer_une_cle_forte_minimum_32_caracteres

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- AI / NLP --------------------------------------------------------------
# LLM provider pour l'extraction structurée (optionnel)
# Sans clé API, le pipeline utilise uniquement spaCy + gazetteer
LLM_PROVIDER=mistral               # mistral | openai | none

# Clés API (optionnelles)
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Modèles spaCy (téléchargés automatiquement si absents)
SPACY_MODEL_FR=fr_core_news_md
SPACY_MODEL_EN=en_core_web_sm

# Modèle d'embedding pour la similarité sémantique
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- Frontend --------------------------------------------------------------
# URL de l'API backend (ajustez selon votre hébergement)
VITE_API_URL=http://localhost:8000/api/v1
# En production : https://api.votre-domaine.com/api/v1

# --- Bootstrap admin (créé lors de la première migration) ------------------
FIRST_ADMIN_EMAIL=admin@phosboucraa.ma
FIRST_ADMIN_PASSWORD=Admin@1234

# =============================================================================
# CHECKLIST AVANT DÉMARRAGE
# =============================================================================
# ✅ J'ai remplacé DATABASE_URL par ma connexion Supabase
# ✅ J'ai activé les extensions "vector" et "uuid-ossp" dans Supabase
# ✅ J'ai généré un nouveau SECRET_KEY avec : openssl rand -hex 32
# ✅ J'ai changé FIRST_ADMIN_PASSWORD
# ✅ J'ai configuré les clés API (MISTRAL_API_KEY ou OPENAI_API_KEY) si je veux utiliser un LLM
# ✅ J'ai vérifié que Redis et MinIO sont accessibles (local ou cloud)
# =============================================================================
