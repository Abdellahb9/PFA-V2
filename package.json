{
  "name": "pfa-vercel",
  "private": true,
  "version": "0.0.0",
  "description": "PFA on Vercel: React frontend (frontend/) + one serverless API (server/, bundled into api/_handler.cjs). CommonJS root so Vercel bundles api/ without runtime ESM resolution.",
  "scripts": {
    "bundle-api": "node scripts/bundle-api.mjs",
    "vercel-build": "node scripts/bundle-api.mjs && npm --prefix frontend install && npm --prefix frontend run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p server",
    "eval:rag": "tsx --env-file-if-exists=.env server/scripts/eval-rag.ts",
    "eval:scope": "tsx --env-file-if-exists=.env server/scripts/eval-scope.ts",
    "rag:demo": "tsx --env-file-if-exists=.env server/scripts/rag-demo.ts",
    "reindex": "tsx --env-file-if-exists=.env server/scripts/reindex.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@vercel/functions": "^1.5.0",
    "groq-sdk": "^0.9.0",
    "mammoth": "^1.8.0",
    "unpdf": "^0.12.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "debug": "^4.4.3",
    "esbuild": "^0.24.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
